---
// SCIA La Margue Est — fiche interne, espace associes.
// Tous les montants viennent de src/data/la-margue-2026.ts : rien en dur ici.
import MargueShell from '~/components/margue/MargueShell.astro'
import SectionHead from '~/components/laom/sections/SectionHead.astro'
import {
  documents,
  documentsNote,
  estCommunsTotaux,
  estKeyFigures,
  estRegle,
  estTotals,
  eur,
  foyersEst,
  notionsEst,
  phases,
  sortantsEst,
  sortantsNote,
  updatedLabel,
  variantes,
} from '~/data/la-margue-2026'

export const prerender = true
---

<MargueShell
  page="est"
  title="SCIA La Margue Est"
  subtitle="Ce que chaque foyer apporte, ce que chaque sortant reçoit, et le prix de la Lyre"
  updated={updatedLabel}
>
  <!-- 1 · Chiffres cles -->
  <section class="pb-16 md:pb-24">
    <div class="max-w-5xl mx-auto px-6 md:px-10">
      <SectionHead
        eyebrow="Vue d'ensemble"
        title="Les chiffres"
        accent="clés"
        size="text-3xl md:text-4xl"
        class="mb-10"
      />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {estKeyFigures.map((fig) => (
          <div class="rounded-2xl bg-[#FBF6EA] border border-[#412F1F]/10 p-6">
            <p class="text-2xl md:text-[1.75rem] font-extrabold text-[#9A3922] tabular-nums tracking-[-0.02em]">
              {fig.value}
            </p>
            <p class="text-sm text-[#1D1B18]/70 mt-2 leading-snug">{fig.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2 · La regle (unique bande sombre de la page) -->
  <section class="bg-[#412F1F] py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 md:px-10">
      <SectionHead
        eyebrow="Le principe"
        title="La"
        accent="règle"
        light={true}
        size="text-3xl md:text-4xl"
        class="mb-8"
      />
      <div class="max-w-3xl space-y-4">
        {estRegle.map((p) => (
          <p class="text-[#F2EBDB]/75 text-base md:text-lg leading-relaxed">{p}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- 3 · Par foyer -->
  <section class="py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 md:px-10">
      <SectionHead
        eyebrow="Par foyer"
        title="Ce que chacun"
        accent="apporte"
        intro="Le capital est la part de chaque foyer dans la SCIA. Les communs se paient en plus, une seule fois. La dernière colonne est ce que le foyer doit réellement sortir."
        size="text-3xl md:text-4xl"
        class="mb-10"
      />

      <div class="overflow-x-auto rounded-2xl border border-[#412F1F]/10 bg-[#FBF6EA]">
        <table class="w-full min-w-[760px] text-sm">
          <thead>
            <tr class="border-b border-[#412F1F]/15 text-left">
              <th class="px-5 py-4 font-semibold text-[#412F1F]">Foyer</th>
              <th class="px-5 py-4 font-semibold text-[#412F1F]">Lot</th>
              <th class="px-5 py-4 font-semibold text-[#412F1F] text-right">Capital</th>
              <th class="px-5 py-4 font-semibold text-[#412F1F] text-right">Communs</th>
              <th class="px-5 py-4 font-semibold text-[#412F1F] text-right">Total à prévoir</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#412F1F]/10">
            {foyersEst.map((f) => (
              <tr class="align-top">
                <td class="px-5 py-4 text-[#412F1F] font-medium">{f.foyer}</td>
                <td class="px-5 py-4 text-[#1D1B18]/70">
                  {f.lot}
                  <span class="block text-xs text-[#1D1B18]/45 mt-1">{f.lotNote}</span>
                </td>
                <td class="px-5 py-4 text-right text-[#1D1B18] tabular-nums whitespace-nowrap">
                  {eur(f.capital)}
                  {f.capitalNote && (
                    <span class="block text-xs text-[#1D1B18]/45 mt-1 whitespace-normal">{f.capitalNote}</span>
                  )}
                </td>
                <td class="px-5 py-4 text-right text-[#1D1B18] tabular-nums whitespace-nowrap">
                  {eur(f.communs)}
                </td>
                <td class="px-5 py-4 text-right text-[#9A3922] font-semibold tabular-nums whitespace-nowrap">
                  {eur(f.total)}
                  {f.totalNote && (
                    <span class="block text-xs font-normal text-[#1D1B18]/45 mt-1 whitespace-normal">{f.totalNote}</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr class="border-t border-[#412F1F]/15">
              <td class="px-5 py-4 font-semibold text-[#412F1F]" colspan="2">Total</td>
              <td class="px-5 py-4 text-right font-semibold text-[#412F1F] tabular-nums whitespace-nowrap">
                {eur(estTotals.capital)}
              </td>
              <td class="px-5 py-4 text-right font-semibold text-[#412F1F] tabular-nums whitespace-nowrap" colspan="2">
                {eur(estTotals.communs)}
              </td>
            </tr>
          </tfoot>
        </table>
      </div>

      <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs text-[#1D1B18]/60">
        {estCommunsTotaux.map((l) => (
          <li>
            {l.label} <span class="text-[#412F1F] font-medium tabular-nums">{eur(l.montant)}</span>
          </li>
        ))}
      </ul>

      <h3 class="text-base font-semibold text-[#412F1F] mt-12 mb-4">Répartition du capital</h3>
      <ul class="flex flex-wrap gap-2">
        {foyersEst.map((f) => (
          <li class="rounded-full bg-[#FBF6EA] border border-[#412F1F]/10 px-4 py-2 text-sm">
            <span class="text-[#412F1F]">{f.foyer}</span>
            <span class="text-[#9A3922] font-semibold ml-2 tabular-nums">{f.partCapital}</span>
          </li>
        ))}
      </ul>

      <h3 class="text-base font-semibold text-[#412F1F] mt-12 mb-4">Le détail, foyer par foyer</h3>
      <div class="space-y-3">
        {foyersEst.map((f) => (
          <details class="m-det group rounded-2xl bg-[#FBF6EA] border border-[#412F1F]/10 px-5 py-4 md:px-6 md:py-5">
            <summary class="flex items-center justify-between gap-4 cursor-pointer">
              <span class="min-w-0">
                <span class="block font-semibold text-[#412F1F]">{f.foyer}</span>
                <span class="block text-sm text-[#1D1B18]/55">{f.lot}</span>
              </span>
              <span class="shrink-0 w-7 h-7 grid place-items-center rounded-full bg-[#9A3922]/10 text-[#9A3922] transition-transform duration-300 group-open:rotate-45">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                  ><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg
                >
              </span>
            </summary>

            <div class="mt-5 grid gap-6 md:grid-cols-[minmax(0,1fr)_18rem]">
              <div class="space-y-3">
                {f.detail.map((p) => (
                  <p class="text-[#1D1B18]/70 leading-relaxed text-sm md:text-base">{p}</p>
                ))}
              </div>
              <div class="rounded-xl bg-[#F2EBDB] p-4">
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[#412F1F]/60 mb-3">Ses communs</p>
                <ul class="space-y-2 text-sm">
                  {f.communsDetail.map((c) => (
                    <li class="flex justify-between gap-3">
                      <span class="text-[#1D1B18]/65">{c.label}</span>
                      <span class="text-[#412F1F] tabular-nums whitespace-nowrap">{eur(c.montant)}</span>
                    </li>
                  ))}
                  <li class="flex justify-between gap-3 pt-2 border-t border-[#412F1F]/10 font-semibold">
                    <span class="text-[#412F1F]">Total</span>
                    <span class="text-[#9A3922] tabular-nums whitespace-nowrap">{eur(f.communs)}</span>
                  </li>
                </ul>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 4 · Ce que les sortants recoivent -->
  <section class="bg-[#FBF6EA] py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 md:px-10">
      <SectionHead
        eyebrow="Les sortants"
        title="Ce qui est"
        accent="remboursé"
        intro="Chacun récupère exactement ce qu'il a mis dans l'indivision, travaux compris."
        size="text-3xl md:text-4xl"
        class="mb-10"
      />

      <div class="overflow-x-auto rounded-2xl border border-[#412F1F]/10 bg-[#F2EBDB]">
        <table class="w-full min-w-[420px] text-sm">
          <thead>
            <tr class="border-b border-[#412F1F]/15 text-left">
              <th class="px-5 py-4 font-semibold text-[#412F1F]">Sortant</th>
              <th class="px-5 py-4 font-semibold text-[#412F1F] text-right">Montant</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#412F1F]/10">
            {sortantsEst.map((s) => (
              <tr>
                <td class="px-5 py-4 text-[#412F1F]">{s.nom}</td>
                <td class="px-5 py-4 text-right text-[#1D1B18] tabular-nums whitespace-nowrap">
                  {eur(s.montant)}
                </td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr class="border-t border-[#412F1F]/15">
              <td class="px-5 py-4 font-semibold text-[#412F1F]">Total</td>
              <td class="px-5 py-4 text-right font-semibold text-[#9A3922] tabular-nums whitespace-nowrap">
                {eur(estTotals.dettes)}
              </td>
            </tr>
          </tfoot>
        </table>
      </div>

      <p class="text-sm text-[#1D1B18]/60 mt-4 max-w-3xl leading-relaxed">{sortantsNote}</p>
    </div>
  </section>

  <!-- 5 · En deux temps -->
  <section class="py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 md:px-10">
      <SectionHead
        eyebrow="Calendrier"
        title="En deux"
        accent="temps"
        intro="Une partie des remboursements se fait à la signature. Le reste attend le foyer qui prendra la Lyre."
        size="text-3xl md:text-4xl"
        class="mb-10"
      />

      <div class="space-y-8">
        {phases.map((phase) => {
        const recus = phase.recus
        return (
          <div class="rounded-2xl bg-[#FBF6EA] border border-[#412F1F]/10 p-6 md:p-8">
            <div class="flex flex-wrap items-baseline justify-between gap-3 mb-6">
              <h3 class="text-xl md:text-2xl font-extrabold text-[#412F1F] tracking-[-0.02em]">
                {phase.titre}
              </h3>
              <p class="text-lg font-extrabold text-[#9A3922] tabular-nums">{eur(phase.total)}</p>
            </div>

            <ul class="divide-y divide-[#412F1F]/10 border-y border-[#412F1F]/10">
              {phase.flux.map((f) => (
                <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3 text-sm">
                  <span class="text-[#1D1B18]/75">
                    {f.payeur} <span class="text-[#9A3922]" aria-hidden="true">&rarr;</span>{' '}
                    <span class="text-[#412F1F] font-medium">{f.beneficiaire}</span>
                    {f.note && <span class="text-[#1D1B18]/45"> · {f.note}</span>}
                  </span>
                  <span class="text-[#1D1B18] tabular-nums whitespace-nowrap">{eur(f.montant)}</span>
                </li>
              ))}
            </ul>

            {recus && (
              <div class="mt-6">
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[#412F1F]/60 mb-3">Reçu à la signature</p>
                <ul class="flex flex-wrap gap-2">
                  {recus.map((r) => (
                    <li class="rounded-full bg-[#F2EBDB] border border-[#412F1F]/10 px-4 py-2 text-sm">
                      <span class="text-[#412F1F]">{r.nom}</span>
                      <span class="text-[#9A3922] font-semibold ml-2 tabular-nums">{eur(r.montant)}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <p class="text-sm text-[#1D1B18]/60 mt-5 leading-relaxed">{phase.note}</p>
          </div>
        )
        })}
      </div>
    </div>
  </section>

  <!-- 6 · Les deux variantes -->
  <section class="bg-[#FBF6EA] py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 md:px-10">
      <SectionHead
        eyebrow="Trésorerie"
        title="Deux variantes en attendant"
        accent="l'entrant"
        size="text-3xl md:text-4xl"
        class="mb-10"
      />
      <div class="grid gap-5 md:grid-cols-2">
        {variantes.map((v) => (
          <div class="rounded-2xl bg-[#F2EBDB] border border-[#412F1F]/10 p-6 md:p-8">
            <p class="eyebrow mb-3">Variante {v.cle}</p>
            <h3 class="text-xl md:text-2xl font-extrabold text-[#412F1F] tracking-[-0.02em] text-balance">
              {v.titre}
            </h3>
            <p class="text-[#1D1B18]/70 mt-3 leading-relaxed">{v.resume}</p>
            <ul class="mt-5 space-y-2.5">
              {v.points.map((p) => (
                <li class="flex gap-3 text-sm text-[#1D1B18]/70 leading-relaxed">
                  <span class="mt-2 shrink-0 w-1.5 h-1.5 rounded-full bg-[#9A3922]" aria-hidden="true"></span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7 · Comprendre les montants -->
  <section class="py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 md:px-10">
      <SectionHead
        eyebrow="Lexique"
        title="Comprendre les"
        accent="montants"
        size="text-3xl md:text-4xl"
        class="mb-10"
      />
      <div class="grid gap-4 md:grid-cols-2">
        {notionsEst.map((n) => (
          <div class="rounded-2xl bg-[#FBF6EA] border border-[#412F1F]/10 p-6">
            <h3 class="text-base font-semibold text-[#412F1F] mb-2">{n.titre}</h3>
            <p class="text-sm text-[#1D1B18]/70 leading-relaxed">{n.texte}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8 · Documents -->
  <section class="bg-[#FBF6EA] py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 md:px-10">
      <SectionHead
        eyebrow="Sources"
        title="Les"
        accent="documents"
        size="text-3xl md:text-4xl"
        class="mb-10"
      />
      <div class="grid gap-4 md:grid-cols-3">
        {documents.map((d) => (
          <a
            href={d.href}
            target="_blank"
            rel="noopener noreferrer"
            class="lift rounded-2xl bg-[#F2EBDB] border border-[#412F1F]/10 p-6 block"
          >
            <h3 class="text-base font-semibold text-[#412F1F]">{d.titre}</h3>
            <p class="text-sm text-[#1D1B18]/65 mt-2 leading-relaxed">{d.description}</p>
            <span class="inline-block text-sm text-[#9A3922] font-medium mt-4">Ouvrir le classeur</span>
          </a>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="/la-margue-notice/" class="pill pill-primary">Lire la notice du montage</a>
        <p class="text-sm text-[#1D1B18]/55">{documentsNote}</p>
      </div>
    </div>
  </section>
</MargueShell>
